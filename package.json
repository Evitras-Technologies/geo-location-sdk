{
  "name": "@evitras-technologies/react-native-background-geolocation",
  "version": "0.1.1",
  "description": "Free, open-source background geolocation SDK for React Native CLI and Expo. Battery-conscious motion-detection tracking, geofencing, SQLite persistence, HTTP sync, headless tasks. API-compatible with the popular transistorsoft plugin surface.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "plugin",
    "docs",
    "app.plugin.js",
    "*.podspec",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "prepare": "bob build",
    "test:android": "cd example-app/android && gradlew :evitras-technologies_react-native-background-geolocation:testReleaseUnitTest",
    "typecheck": "tsc --noEmit",
    "build": "bob build",
    "prepublishOnly": "bob build",
    "clean": "del-cli lib"
  },
  "keywords": [
    "react-native",
    "expo",
    "background-geolocation",
    "geolocation",
    "geofence",
    "geofencing",
    "location",
    "tracking",
    "gps",
    "background",
    "motion-detection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evitras-Technologies/geo-location-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Evitras-Technologies/geo-location-sdk/issues"
  },
  "homepage": "https://github.com/Evitras-Technologies/geo-location-sdk#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.0",
    "del-cli": "^5.1.0",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "react-native-builder-bob": "^0.23.2",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.0"
  },
  "codegenConfig": {
    "name": "RNOpenBackgroundGeolocationSpec",
    "type": "modules",
    "jsSrcsDir": "src"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
